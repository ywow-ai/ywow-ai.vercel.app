---
import { tw } from "../lib/tw";

/** Tier visibility: base → sm → md → lg → xl (progressive density) */
const tier = {
  sm: "hidden sm:block",
  md: "hidden md:block",
  lg: "hidden lg:block",
  xl: "hidden xl:block",
} as const;

const shapeOpacity =
  "opacity-45 sm:opacity-55 md:opacity-65 lg:opacity-75 xl:opacity-80";
---

<div
  aria-hidden="true"
  class={`pointer-events-none fixed inset-0 z-0 overflow-hidden ${tw.pageBg}`}
  data-parallax-bg
>
  <!-- Ambient glow -->
  <div
    class="parallax-layer absolute -top-32 -left-32 h-64 w-64 sm:-top-36 sm:-left-36 sm:h-80 sm:w-80 md:h-96 md:w-96 lg:-top-40 lg:-left-40 lg:h-120 lg:w-120"
    data-speed="0.06"
  >
    <div
      class="h-full w-full animate-pulse rounded-full bg-purple-400/20 blur-3xl sm:bg-purple-400/25 lg:bg-purple-400/30"
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-1/3 -right-24 h-48 w-48 sm:-right-28 sm:h-56 sm:w-56 md:h-64 md:w-64 ${tier.sm}`}
    data-speed="0.04"
  >
    <div
      class="h-full w-full animate-[pulse_4s_ease-in-out_infinite] rounded-full bg-indigo-400/20 blur-3xl md:bg-indigo-400/25"
    >
    </div>
  </div>
  <div
    class="parallax-layer absolute -bottom-32 -right-32 h-64 w-64 sm:-bottom-36 sm:-right-36 sm:h-80 sm:w-80 md:h-96 md:w-96 lg:-bottom-40 lg:-right-40 lg:h-120 lg:w-120"
    data-speed="-0.05"
  >
    <div
      class="h-full w-full animate-[pulse_5s_ease-in-out_infinite] rounded-full bg-pink-400/15 blur-3xl sm:bg-pink-400/18 lg:bg-pink-400/20 [animation-delay:1s]"
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[60%] left-[20%] h-32 w-32 md:h-40 md:w-40 lg:h-48 lg:w-48 ${tier.md}`}
    data-speed="0.03"
  >
    <div
      class="h-full w-full animate-[pulse_6s_ease-in-out_infinite] rounded-full bg-purple-400/10 blur-3xl lg:bg-purple-400/15 [animation-delay:2s]"
    >
    </div>
  </div>

  <!-- ═══ X ═══ -->
  <div
    class={`parallax-layer absolute top-[8%] left-[6%] h-4 w-4 sm:h-5 sm:w-5 md:h-6 md:w-6 lg:h-7 lg:w-7 ${shapeOpacity}`}
    data-speed="0.28"
  >
    <div class="relative h-full w-full animate-[bounce_4s_ease-in-out_infinite] -rotate-12">
      <div class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 rotate-45 rounded bg-indigo-400/60"></div>
      <div class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 -rotate-45 rounded bg-indigo-400/60"></div>
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[22%] left-[82%] h-6 w-6 md:h-7 md:w-7 lg:h-8 lg:w-8 ${shapeOpacity} ${tier.sm}`}
    data-speed="-0.22"
  >
    <div class="relative h-full w-full animate-pulse rotate-[8deg]">
      <div class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 rotate-45 rounded bg-indigo-400/60"></div>
      <div class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 -rotate-45 rounded bg-indigo-400/60"></div>
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[48%] left-[12%] h-8 w-8 md:h-10 md:w-10 lg:h-12 lg:w-12 ${shapeOpacity} ${tier.md}`}
    data-speed="0.18"
  >
    <div class="relative h-full w-full animate-[spin_20s_linear_infinite] rotate-15">
      <div class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 rotate-45 rounded bg-purple-400/60"></div>
      <div class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 -rotate-45 rounded bg-purple-400/60"></div>
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[72%] left-[84%] h-4 w-4 sm:left-[86%] sm:h-5 sm:w-5 md:left-[88%] ${shapeOpacity}`}
    data-speed="-0.3"
  >
    <div class="relative h-full w-full animate-[bounce_3s_ease-in-out_infinite] rotate-[-20deg] [animation-delay:0.5s]">
      <div class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 rotate-45 rounded bg-pink-400/60"></div>
      <div class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 -rotate-45 rounded bg-pink-400/60"></div>
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[33%] left-[90%] lg:left-[93%] h-5 w-5 lg:h-6 lg:w-6 opacity-60 lg:opacity-70 ${tier.lg}`}
    data-speed="0.24"
  >
    <div class="relative h-full w-full animate-[pulse_3s_ease-in-out_infinite] rotate-25">
      <div class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 rotate-45 rounded bg-pink-400/50"></div>
      <div class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 -rotate-45 rounded bg-pink-400/50"></div>
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[90%] left-[40%] h-5 w-5 lg:h-7 lg:w-7 opacity-65 lg:opacity-75 ${tier.lg}`}
    data-speed="0.16"
  >
    <div class="relative h-full w-full animate-[spin_14s_linear_infinite_reverse] rotate-[-8deg]">
      <div class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 rotate-45 rounded bg-indigo-400/55"></div>
      <div class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 -rotate-45 rounded bg-indigo-400/55"></div>
    </div>
  </div>

  <!-- ═══ Squares ═══ -->
  <div
    class={`parallax-layer absolute top-[14%] left-[42%] h-5 w-5 sm:h-6 sm:w-6 md:h-7 md:w-7 lg:h-8 lg:w-8 ${shapeOpacity}`}
    data-speed="0.15"
  >
    <div class="h-full w-full animate-[spin_16s_linear_infinite] rotate-12 rounded border-2 border-purple-400/50 bg-purple-400/10"></div>
  </div>
  <div
    class={`parallax-layer absolute top-[35%] left-[68%] h-8 w-8 md:h-10 md:w-10 lg:h-12 lg:w-12 ${shapeOpacity} ${tier.sm}`}
    data-speed="-0.12"
  >
    <div class="h-full w-full animate-[pulse_2.5s_ease-in-out_infinite] rotate-[-8deg] rounded-xl border-2 border-pink-400/50 bg-pink-400/10"></div>
  </div>
  <div
    class={`parallax-layer absolute top-[58%] left-[48%] h-4 w-4 md:h-5 md:w-5 ${shapeOpacity} ${tier.md}`}
    data-speed="0.32"
  >
    <div class="h-full w-full animate-bounce rotate-22 rounded border-2 border-indigo-400/50 bg-indigo-400/10 [animation-duration:3s]"></div>
  </div>
  <div
    class={`parallax-layer absolute top-[78%] left-[8%] h-8 w-8 sm:h-10 sm:w-10 md:h-12 md:w-12 lg:h-16 lg:w-16 ${shapeOpacity}`}
    data-speed="-0.18"
  >
    <div class="h-full w-full animate-[spin_25s_linear_infinite_reverse] rotate-[-15deg] rounded-xl border-2 border-purple-400/50 bg-purple-400/10"></div>
  </div>
  <div
    class={`parallax-layer absolute top-[42%] left-[88%] lg:left-[92%] h-6 w-6 lg:h-8 lg:w-8 ${shapeOpacity} ${tier.lg}`}
    data-speed="0.2"
  >
    <div class="h-full w-full animate-spin rounded border-2 border-pink-400/50 bg-pink-400/10 [animation-duration:8s]"></div>
  </div>
  <div
    class={`parallax-layer absolute top-[6%] left-[72%] md:left-[75%] h-5 w-5 md:h-6 md:w-6 opacity-60 md:opacity-75 ${tier.md}`}
    data-speed="-0.14"
  >
    <div class="h-full w-full animate-[bounce_5s_ease-in-out_infinite] rotate-45 rounded border-2 border-indigo-400/45 bg-indigo-400/10"></div>
  </div>
  <div
    class={`parallax-layer absolute top-[64%] left-[72%] md:left-[75%] h-7 w-7 md:h-9 md:w-9 lg:h-10 lg:w-10 opacity-60 lg:opacity-70 ${tier.lg}`}
    data-speed="0.11"
  >
    <div class="h-full w-full animate-[pulse_4s_ease-in-out_infinite] rotate-30 rounded-lg border-2 border-purple-400/40 bg-purple-400/10 [animation-delay:1.5s]"></div>
  </div>
  <div
    class={`parallax-layer absolute top-[95%] left-[18%] h-5 w-5 lg:h-7 lg:w-7 ${shapeOpacity} ${tier.xl}`}
    data-speed="-0.22"
  >
    <div class="h-full w-full animate-[spin_12s_linear_infinite] rounded border-2 border-pink-400/45 bg-pink-400/10"></div>
  </div>

  <!-- ═══ Triangles ═══ -->
  <div class="parallax-layer absolute top-[18%] left-[22%] opacity-45 sm:opacity-55 md:opacity-65 lg:opacity-80" data-speed="-0.25">
    <div class="h-0 w-0 origin-center scale-75 animate-[bounce_4.5s_ease-in-out_infinite] rotate-15 border-x-10 border-b-18 border-x-transparent border-b-pink-400/50 sm:scale-90 sm:border-x-12 sm:border-b-20 md:scale-100 md:border-x-14 md:border-b-24"></div>
  </div>
  <div class={`parallax-layer absolute top-[52%] left-[78%] ${shapeOpacity} ${tier.md}`} data-speed="0.14">
    <div class="h-0 w-0 origin-center scale-75 animate-pulse rotate-170 border-x-16 border-b-28 border-x-transparent border-b-indigo-400/50 md:scale-90 md:border-x-22 md:border-b-38"></div>
  </div>
  <div class="parallax-layer absolute top-[68%] left-[62%] opacity-45 sm:left-[58%] sm:opacity-55 md:opacity-65 lg:opacity-80" data-speed="-0.2">
    <div class="h-0 w-0 origin-center scale-75 animate-[spin_18s_linear_infinite] rotate-45 border-x-8 border-b-14 border-x-transparent border-b-purple-400/50 sm:scale-90 sm:border-x-10 sm:border-b-18"></div>
  </div>
  <div class={`parallax-layer absolute top-[85%] left-[68%] lg:left-[72%] ${shapeOpacity} ${tier.lg}`} data-speed="0.1">
    <div class="h-0 w-0 origin-center scale-75 animate-[pulse_3.5s_ease-in-out_infinite] rotate-[-30deg] border-x-20 border-b-36 border-x-transparent border-b-pink-400/50 lg:scale-100 lg:border-x-30 lg:border-b-52 [animation-delay:0.8s]"></div>
  </div>
  <div class={`parallax-layer absolute top-[30%] left-[5%] ${shapeOpacity} ${tier.sm}`} data-speed="0.26">
    <div class="h-0 w-0 origin-center scale-75 animate-[bounce_6s_ease-in-out_infinite] rotate-90 border-x-10 border-b-18 border-x-transparent border-b-indigo-400/50 sm:scale-90 sm:border-x-14 sm:border-b-24"></div>
  </div>
  <div class={`parallax-layer absolute top-[12%] left-[55%] opacity-55 md:opacity-70 ${tier.md}`} data-speed="-0.18">
    <div class="h-0 w-0 origin-center scale-75 animate-[spin_22s_linear_infinite_reverse] rotate-60 border-x-6 border-b-10 border-x-transparent border-b-purple-400/45 md:scale-100 md:border-x-8 md:border-b-14"></div>
  </div>
  <div class={`parallax-layer absolute top-[44%] left-[35%] opacity-55 lg:opacity-75 ${tier.lg}`} data-speed="0.08">
    <div class="h-0 w-0 origin-center scale-75 animate-[pulse_5s_ease-in-out_infinite] -rotate-12 border-x-10 border-b-16 border-x-transparent border-b-pink-400/45 lg:scale-100 lg:border-x-12 lg:border-b-20 [animation-delay:2s]"></div>
  </div>

  <!-- ═══ Circles ═══ -->
  <div
    class={`parallax-layer absolute top-[10%] left-[58%] h-7 w-7 sm:h-8 sm:w-8 md:h-10 md:w-10 lg:h-12 lg:w-12 ${shapeOpacity}`}
    data-speed="0.12"
  >
    <div class="h-full w-full animate-[pulse_2s_ease-in-out_infinite] rounded-full border-2 border-purple-400/50 bg-purple-400/10"></div>
  </div>
  <div
    class={`parallax-layer absolute top-[38%] left-[30%] h-6 w-6 md:h-7 md:w-7 lg:h-8 lg:w-8 ${shapeOpacity} ${tier.sm}`}
    data-speed="-0.16"
  >
    <div class="relative h-full w-full">
      <div class="absolute inset-0 animate-ping rounded-full bg-indigo-400/20 [animation-duration:3s]"></div>
      <div class="relative h-full w-full rounded-full bg-indigo-400/25"></div>
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[62%] left-[22%] h-4 w-4 sm:h-5 sm:w-5 ${shapeOpacity}`}
    data-speed="0.22"
  >
    <div class="h-full w-full animate-[bounce_3.5s_ease-in-out_infinite] rounded-full border-2 border-pink-400/50 [animation-delay:0.3s]"></div>
  </div>
  <div
    class={`parallax-layer absolute top-[55%] left-[84%] lg:left-[88%] h-10 w-10 md:h-12 md:w-12 lg:h-16 lg:w-16 ${shapeOpacity} ${tier.lg}`}
    data-speed="-0.1"
  >
    <div class="h-full w-full animate-spin rounded-full border-2 border-indigo-400/50 [animation-duration:10s]"></div>
  </div>
  <div
    class={`parallax-layer absolute top-[82%] left-[52%] h-6 w-6 lg:h-8 lg:w-8 ${shapeOpacity} ${tier.md}`}
    data-speed="0.19"
  >
    <div class="h-full w-full animate-[spin_20s_linear_infinite_reverse] rounded-full border-2 border-purple-400/50"></div>
  </div>
  <div
    class={`parallax-layer absolute top-[25%] left-[90%] xl:left-[95%] h-4 w-4 lg:h-5 lg:w-5 ${shapeOpacity} ${tier.xl}`}
    data-speed="-0.28"
  >
    <div class="h-full w-full animate-[bounce_4s_ease-in-out_infinite] rounded-full bg-pink-400/25"></div>
  </div>
  <div
    class={`parallax-layer absolute top-[70%] left-[90%] xl:left-[95%] h-7 w-7 lg:h-9 lg:w-9 xl:h-10 xl:w-10 opacity-60 xl:opacity-70 ${tier.xl}`}
    data-speed="0.13"
  >
    <div class="h-full w-full animate-[pulse_4s_ease-in-out_infinite] rounded-full border-2 border-indigo-400/40 bg-indigo-400/10 [animation-delay:1s]"></div>
  </div>
  <div
    class={`parallax-layer absolute top-[20%] left-[38%] h-5 w-5 lg:h-6 lg:w-6 opacity-60 lg:opacity-75 ${tier.lg}`}
    data-speed="-0.09"
  >
    <div class="h-full w-full animate-[spin_7s_linear_infinite] rounded-full bg-purple-400/20"></div>
  </div>
  <div
    class={`parallax-layer absolute top-[50%] left-[3%] h-8 w-8 md:h-10 md:w-10 lg:h-12 lg:w-12 xl:h-14 xl:w-14 opacity-50 lg:opacity-65 ${tier.xl}`}
    data-speed="0.17"
  >
    <div class="relative h-full w-full">
      <div class="absolute inset-0 animate-ping rounded-full border border-pink-400/30 [animation-duration:4s]"></div>
      <div class="relative m-1.5 h-[calc(100%-0.75rem)] w-[calc(100%-0.75rem)] animate-[spin_30s_linear_infinite] rounded-full border-2 border-pink-400/40 lg:m-2 lg:h-[calc(100%-1rem)] lg:w-[calc(100%-1rem)]"></div>
    </div>
  </div>

  <!-- ═══ Stars ═══ -->
  <div class={`parallax-layer absolute top-[45%] left-[3%] ${tier.md}`} data-speed="0.3">
    <span class="block animate-[pulse_2.5s_ease-in-out_infinite] text-base text-purple-400 opacity-50 md:text-lg md:opacity-60 lg:text-xl lg:opacity-70">✦</span>
  </div>
  <div class={`parallax-layer absolute top-[15%] left-[72%] md:left-[75%] ${tier.sm}`} data-speed="-0.2">
    <span class="block animate-[bounce_5s_ease-in-out_infinite] text-sm text-indigo-400 opacity-50 sm:text-base sm:opacity-60 lg:opacity-70">✧</span>
  </div>
  <div class={`parallax-layer absolute top-[65%] left-[88%] lg:left-[92%] ${tier.lg}`} data-speed="0.15">
    <span class="block animate-[pulse_3s_ease-in-out_infinite] text-base text-pink-400 opacity-55 lg:text-lg lg:opacity-70 [animation-delay:1.2s]">✦</span>
  </div>
  <div class={`parallax-layer absolute top-[8%] left-[18%] ${tier.md}`} data-speed="0.21">
    <span class="block animate-[bounce_4s_ease-in-out_infinite] text-xs text-purple-400/80 opacity-50 sm:text-sm sm:opacity-60 [animation-delay:0.6s]">✧</span>
  </div>
  <div class={`parallax-layer absolute top-[88%] left-[62%] ${tier.xl}`} data-speed="-0.11">
    <span class="block animate-pulse text-sm text-indigo-400/80 opacity-50 lg:text-base lg:opacity-60">✦</span>
  </div>
</div>

<script>
  (function () {
    const container = document.querySelector("[data-parallax-bg]");
    if (
      !container ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    )
      return;

    const layers = container.querySelectorAll(".parallax-layer");
    let ticking = false;

    function parallaxStrength(): number {
      const w = window.innerWidth;
      if (w < 640) return 0;
      if (w < 768) return 0.35;
      if (w < 1024) return 0.6;
      if (w < 1280) return 0.85;
      return 1;
    }

    function update() {
      const strength = parallaxStrength();
      const scrollY = window.scrollY;

      layers.forEach((layer) => {
        const el = layer as HTMLElement;
        if (strength === 0) {
          el.style.transform = "";
          return;
        }
        const speed = parseFloat(el.dataset.speed ?? "0");
        el.style.transform = `translate3d(0, ${scrollY * speed * strength}px, 0)`;
      });
      ticking = false;
    }

    window.addEventListener("resize", () => update(), { passive: true });
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );

    update();
  })();
</script>

    data-speed="-0.25"
  >
    <div
      class="h-0 w-0 origin-center scale-75 animate-[bounce_4.5s_ease-in-out_infinite] rotate-15 border-x-10 border-b-18 border-x-transparent border-b-pink-400/50 sm:scale-90 sm:border-x-12 sm:border-b-20 md:scale-100 md:border-x-14 md:border-b-24"
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[52%] left-[76%] sm:left-[78%] ${shapeOpacity}`}
    data-speed="0.14"
  >
    <div
      class="h-0 w-0 origin-center scale-50 animate-pulse rotate-170 border-x-12 border-b-20 border-x-transparent border-b-indigo-400/50 sm:scale-75 sm:border-x-16 sm:border-b-28 md:scale-90 md:border-x-22 md:border-b-38"
    >
    </div>
  </div>
  <div
    class="parallax-layer absolute top-[68%] left-[62%] opacity-45 sm:left-[58%] sm:opacity-55 md:opacity-65 lg:opacity-80"
    data-speed="-0.2"
  >
    <div
      class="h-0 w-0 origin-center scale-75 animate-[spin_18s_linear_infinite] rotate-45 border-x-8 border-b-14 border-x-transparent border-b-purple-400/50 sm:scale-90 sm:border-x-10 sm:border-b-18"
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[85%] left-[68%] lg:left-[72%] ${shapeOpacity} ${tier.lg}`}
    data-speed="0.1"
  >
    <div
      class="h-0 w-0 origin-center scale-75 animate-[pulse_3.5s_ease-in-out_infinite] rotate-[-30deg] border-x-20 border-b-36 border-x-transparent border-b-pink-400/50 lg:scale-100 lg:border-x-30 lg:border-b-52 [animation-delay:0.8s]"
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[30%] left-[5%] ${shapeOpacity}`}
    data-speed="0.26"
  >
    <div
      class="h-0 w-0 origin-center scale-75 animate-[bounce_6s_ease-in-out_infinite] rotate-90 border-x-10 border-b-18 border-x-transparent border-b-indigo-400/50 sm:scale-90 sm:border-x-14 sm:border-b-24"
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[12%] left-[53%] sm:left-[55%] opacity-50 md:opacity-70`}
    data-speed="-0.18"
  >
    <div
      class="h-0 w-0 origin-center scale-75 animate-[spin_22s_linear_infinite_reverse] rotate-60 border-x-6 border-b-10 border-x-transparent border-b-purple-400/45 md:scale-100 md:border-x-8 md:border-b-14"
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[44%] left-[35%] opacity-55 lg:opacity-75 ${tier.lg}`}
    data-speed="0.08"
  >
    <div
      class="h-0 w-0 origin-center scale-75 animate-[pulse_5s_ease-in-out_infinite] -rotate-12 border-x-10 border-b-16 border-x-transparent border-b-pink-400/45 lg:scale-100 lg:border-x-12 lg:border-b-20 [animation-delay:2s]"
    >
    </div>
  </div>

  <!-- ═══ Circles ═══ -->
  <div
    class={`parallax-layer absolute top-[10%] left-[58%] h-7 w-7 sm:h-8 sm:w-8 md:h-10 md:w-10 lg:h-12 lg:w-12 ${shapeOpacity}`}
    data-speed="0.12"
  >
    <div
      class="h-full w-full animate-[pulse_2s_ease-in-out_infinite] rounded-full border-2 border-purple-400/50 bg-purple-400/10"
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[38%] left-[28%] sm:left-[30%] h-4 w-4 sm:h-5 sm:w-5 md:h-7 md:w-7 lg:h-8 lg:w-8 ${shapeOpacity}`}
    data-speed="-0.16"
  >
    <div class="relative h-full w-full">
      <div
        class="absolute inset-0 animate-ping rounded-full bg-indigo-400/20 [animation-duration:3s]"
      >
      </div>
      <div class="relative h-full w-full rounded-full bg-indigo-400/25"></div>
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[62%] left-[22%] h-4 w-4 sm:h-5 sm:w-5 ${shapeOpacity}`}
    data-speed="0.22"
  >
    <div
      class="h-full w-full animate-[bounce_3.5s_ease-in-out_infinite] rounded-full border-2 border-pink-400/50 [animation-delay:0.3s]"
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[55%] left-[84%] lg:left-[88%] h-10 w-10 md:h-12 md:w-12 lg:h-16 lg:w-16 ${shapeOpacity} ${tier.lg}`}
    data-speed="-0.1"
  >
    <div
      class="h-full w-full animate-spin rounded-full border-2 border-indigo-400/50 [animation-duration:10s]"
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[82%] left-[50%] sm:left-[52%] h-4 w-4 sm:h-5 sm:w-5 md:h-6 md:w-6 lg:h-8 lg:w-8 ${shapeOpacity}`}
    data-speed="0.19"
  >
    <div
      class="h-full w-full animate-[spin_20s_linear_infinite_reverse] rounded-full border-2 border-purple-400/50"
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[25%] left-[90%] xl:left-[95%] h-4 w-4 lg:h-5 lg:w-5 ${shapeOpacity} ${tier.xl}`}
    data-speed="-0.28"
  >
    <div
      class="h-full w-full animate-[bounce_4s_ease-in-out_infinite] rounded-full bg-pink-400/25"
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[70%] left-[90%] xl:left-[95%] h-7 w-7 lg:h-9 lg:w-9 xl:h-10 xl:w-10 opacity-60 xl:opacity-70 ${tier.xl}`}
    data-speed="0.13"
  >
    <div
      class="h-full w-full animate-[pulse_4s_ease-in-out_infinite] rounded-full border-2 border-indigo-400/40 bg-indigo-400/10 [animation-delay:1s]"
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[20%] left-[36%] sm:left-[38%] h-3.5 w-3.5 sm:h-4 sm:w-4 lg:h-6 lg:w-6 opacity-50 lg:opacity-75`}
    data-speed="-0.09"
  >
    <div
      class="h-full w-full animate-[spin_7s_linear_infinite] rounded-full bg-purple-400/20"
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[50%] left-[3%] h-8 w-8 md:h-10 md:w-10 lg:h-12 lg:w-12 xl:h-14 xl:w-14 opacity-50 lg:opacity-65 ${tier.xl}`}
    data-speed="0.17"
  >
    <div class="relative h-full w-full">
      <div
        class="absolute inset-0 animate-ping rounded-full border border-pink-400/30 [animation-duration:4s]"
      >
      </div>
      <div
        class="relative m-1.5 h-[calc(100%-0.75rem)] w-[calc(100%-0.75rem)] animate-[spin_30s_linear_infinite] rounded-full border-2 border-pink-400/40 lg:m-2 lg:h-[calc(100%-1rem)] lg:w-[calc(100%-1rem)]"
      >
      </div>
    </div>
  </div>

  <!-- ═══ Stars ═══ -->
  <div class={`parallax-layer absolute top-[45%] left-[3%]`} data-speed="0.3">
    <span
      class="block animate-[pulse_2.5s_ease-in-out_infinite] text-sm text-purple-400 opacity-45 sm:text-base sm:opacity-50 md:text-lg md:opacity-60 lg:text-xl lg:opacity-70"
      >✦</span
    >
  </div>
  <div
    class={`parallax-layer absolute top-[15%] left-[70%] sm:left-[72%] md:left-[75%]`}
    data-speed="-0.2"
  >
    <span
      class="block animate-[bounce_5s_ease-in-out_infinite] text-xs text-indigo-400 opacity-45 sm:text-sm sm:opacity-50 md:text-base md:opacity-60 lg:opacity-70"
      >✧</span
    >
  </div>
  <div
    class={`parallax-layer absolute top-[65%] left-[88%] lg:left-[92%] ${tier.lg}`}
    data-speed="0.15"
  >
    <span
      class="block animate-[pulse_3s_ease-in-out_infinite] text-base text-pink-400 opacity-55 lg:text-lg lg:opacity-70 [animation-delay:1.2s]"
      >✦</span
    >
  </div>
  <div class={`parallax-layer absolute top-[8%] left-[18%]`} data-speed="0.21">
    <span
      class="block animate-[bounce_4s_ease-in-out_infinite] text-[10px] text-purple-400/80 opacity-45 sm:text-xs sm:opacity-50 md:text-sm md:opacity-60 [animation-delay:0.6s]"

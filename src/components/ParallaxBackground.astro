---
/** Tier visibility: extra density from sm → xl (mobile base is already populated) */
const tier = {
  sm: "hidden sm:block",
  md: "hidden md:block",
  lg: "hidden lg:block",
  xl: "hidden xl:block",
} as const;

const shapeOpacity =
  "opacity-50 sm:opacity-55 md:opacity-65 lg:opacity-75 xl:opacity-80";

/** Square sizes — stay small until md/lg */
const sq = {
  xs: "h-3 w-3 sm:h-4 sm:w-4 md:h-5 md:w-5 lg:h-6 lg:w-6",
  sm: "h-3.5 w-3.5 sm:h-5 sm:w-5 md:h-7 md:w-7 lg:h-8 lg:w-8",
  md: "h-4 w-4 sm:h-6 sm:w-6 md:h-8 md:w-8 lg:h-10 lg:w-10",
  lg: "h-4 w-4 sm:h-5 sm:w-5 md:h-8 md:w-8 lg:h-12 lg:w-12 xl:h-16 xl:w-16",
} as const;

const sqBorder = "border md:border-2";
const sqRadius = "rounded-sm md:rounded-lg lg:rounded-xl";
---

<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-0 overflow-hidden"
  data-parallax-bg
>
  <!-- Ambient glow -->
  <div
    class="parallax-layer absolute -top-32 -left-32 h-64 w-64 sm:-top-36 sm:-left-36 sm:h-80 sm:w-80 md:h-96 md:w-96 lg:-top-40 lg:-left-40 lg:h-120 lg:w-120"
    data-speed="0.06"
  >
    <div
      class="h-full w-full animate-pulse rounded-full bg-purple-400/20 blur-3xl sm:bg-purple-400/25 lg:bg-purple-400/30"
    >
    </div>
  </div>
  <div
    class="parallax-layer absolute top-1/3 -right-20 h-40 w-40 sm:-right-28 sm:h-56 sm:w-56 md:h-64 md:w-64"
    data-speed="0.04"
  >
    <div
      class="h-full w-full animate-[pulse_4s_ease-in-out_infinite] rounded-full bg-indigo-400/20 blur-3xl md:bg-indigo-400/25"
    >
    </div>
  </div>
  <div
    class="parallax-layer absolute -bottom-32 -right-32 h-64 w-64 sm:-bottom-36 sm:-right-36 sm:h-80 sm:w-80 md:h-96 md:w-96 lg:-bottom-40 lg:-right-40 lg:h-120 lg:w-120"
    data-speed="-0.05"
  >
    <div
      class="h-full w-full animate-[pulse_5s_ease-in-out_infinite] rounded-full bg-pink-400/15 blur-3xl sm:bg-pink-400/18 lg:bg-pink-400/20 [animation-delay:1s]"
    >
    </div>
  </div>
  <div
    class="parallax-layer absolute top-[60%] left-[20%] h-24 w-24 sm:h-28 sm:w-28 md:h-40 md:w-40 lg:h-48 lg:w-48"
    data-speed="0.03"
  >
    <div
      class="h-full w-full animate-[pulse_6s_ease-in-out_infinite] rounded-full bg-purple-400/10 blur-3xl lg:bg-purple-400/15 [animation-delay:2s]"
    >
    </div>
  </div>

  <!-- ═══ X ═══ -->
  <div
    class={`parallax-layer absolute top-[8%] left-[6%] h-4 w-4 sm:h-5 sm:w-5 md:h-6 md:w-6 lg:h-7 lg:w-7 ${shapeOpacity}`}
    data-speed="0.28"
  >
    <div
      class="relative h-full w-full animate-[bounce_4s_ease-in-out_infinite] -rotate-12"
    >
      <div
        class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 rotate-45 rounded bg-indigo-400/60"
      >
      </div>
      <div
        class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 -rotate-45 rounded bg-indigo-400/60"
      >
      </div>
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[22%] left-[80%] h-3.5 w-3.5 sm:left-[82%] sm:h-5 sm:w-5 md:h-7 md:w-7 lg:h-8 lg:w-8 ${shapeOpacity}`}
    data-speed="-0.22"
  >
    <div class="relative h-full w-full animate-pulse rotate-[8deg]">
      <div
        class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 rotate-45 rounded bg-indigo-400/60"
      >
      </div>
      <div
        class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 -rotate-45 rounded bg-indigo-400/60"
      >
      </div>
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[48%] left-[10%] h-4 w-4 sm:left-[12%] sm:h-6 sm:w-6 md:h-8 md:w-8 lg:h-12 lg:w-12 ${shapeOpacity}`}
    data-speed="0.18"
  >
    <div
      class="relative h-full w-full animate-[spin_20s_linear_infinite] rotate-15"
    >
      <div
        class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 rotate-45 rounded bg-purple-400/60"
      >
      </div>
      <div
        class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 -rotate-45 rounded bg-purple-400/60"
      >
      </div>
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[72%] left-[84%] h-4 w-4 sm:left-[86%] sm:h-5 sm:w-5 md:left-[88%] ${shapeOpacity}`}
    data-speed="-0.3"
  >
    <div
      class="relative h-full w-full animate-[bounce_3s_ease-in-out_infinite] rotate-[-20deg] [animation-delay:0.5s]"
    >
      <div
        class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 rotate-45 rounded bg-pink-400/60"
      >
      </div>
      <div
        class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 -rotate-45 rounded bg-pink-400/60"
      >
      </div>
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[33%] left-[90%] lg:left-[93%] h-5 w-5 lg:h-6 lg:w-6 opacity-60 lg:opacity-70 ${tier.lg}`}
    data-speed="0.24"
  >
    <div
      class="relative h-full w-full animate-[pulse_3s_ease-in-out_infinite] rotate-25"
    >
      <div
        class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 rotate-45 rounded bg-pink-400/50"
      >
      </div>
      <div
        class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 -rotate-45 rounded bg-pink-400/50"
      >
      </div>
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[90%] left-[40%] h-5 w-5 lg:h-7 lg:w-7 opacity-65 lg:opacity-75 ${tier.lg}`}
    data-speed="0.16"
  >
    <div
      class="relative h-full w-full animate-[spin_14s_linear_infinite_reverse] rotate-[-8deg]"
    >
      <div
        class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 rotate-45 rounded bg-indigo-400/55"

  >
    <div
      class={`h-full w-full animate-bounce rotate-22 ${sqRadius} ${sqBorder} border-indigo-400/50 bg-indigo-400/10 [animation-duration:3s]`}
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[78%] left-[6%] sm:left-[8%] ${sq.lg} ${shapeOpacity}`}
    data-speed="-0.18"
  >
    <div
      class={`h-full w-full animate-[spin_25s_linear_infinite_reverse] rotate-[-15deg] ${sqRadius} ${sqBorder} border-purple-400/50 bg-purple-400/10`}
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[42%] left-[88%] lg:left-[92%] ${sq.sm} ${shapeOpacity} ${tier.lg}`}
    data-speed="0.2"
  >
    <div
      class={`h-full w-full animate-spin ${sqRadius} ${sqBorder} border-pink-400/50 bg-pink-400/10 [animation-duration:8s]`}
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[6%] left-[68%] sm:left-[72%] md:left-[75%] ${sq.xs} opacity-55 md:opacity-75`}
    data-speed="-0.14"
  >
    <div
      class={`h-full w-full animate-[bounce_5s_ease-in-out_infinite] rotate-45 ${sqRadius} ${sqBorder} border-indigo-400/45 bg-indigo-400/10`}
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[64%] left-[72%] md:left-[75%] ${sq.sm} opacity-60 lg:opacity-70 ${tier.lg}`}
    data-speed="0.11"
  >
    <div
      class={`h-full w-full animate-[pulse_4s_ease-in-out_infinite] rotate-30 rounded-sm md:rounded-lg ${sqBorder} border-purple-400/40 bg-purple-400/10 [animation-delay:1.5s]`}
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[95%] left-[18%] ${sq.xs} ${shapeOpacity} ${tier.xl}`}
    data-speed="-0.22"
  >
    <div
      class={`h-full w-full animate-[spin_12s_linear_infinite] ${sqRadius} ${sqBorder} border-pink-400/45 bg-pink-400/10`}
    >
    </div>
  </div>

  <!-- ═══ Triangles ═══ -->
  <div

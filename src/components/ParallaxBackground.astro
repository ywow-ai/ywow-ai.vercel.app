  >
    <div
      class={`h-full w-full animate-[pulse_2.5s_ease-in-out_infinite] rotate-[-8deg] ${sqRadius} ${sqBorder} border-pink-400/50 bg-pink-400/10`}
    >
    </div>
  </div>
  <div
    class={`parallax-layer absolute top-[58%] left-[46%] sm:left-[48%] ${sq.xs} ${shapeOpacity}`}

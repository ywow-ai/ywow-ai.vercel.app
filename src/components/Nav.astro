---
import { navLinks, siteConfig } from '../data/site';
import { tw } from '../lib/tw';
import ThemeToggle from './ThemeToggle.astro';
---

<nav class={`fixed top-0 z-50 w-full border-b transition-all duration-500 ease-out ${tw.navBg}`} data-nav>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="#home" class={`${tw.display} text-2xl font-bold ${tw.gradientText} transition-opacity duration-300 hover:opacity-80`}>
      {siteConfig.name}
    </a>

    <ul class="relative hidden items-center gap-1 md:flex">
      <span
        aria-hidden="true"
        data-nav-indicator
        class="pointer-events-none absolute bottom-0 h-0.5 rounded-full bg-linear-to-r from-purple-400 via-indigo-400 to-pink-400 opacity-0 transition-all duration-500 ease-out"
      ></span>
      {navLinks.map((link) => (
        <li>
          <a href={link.href} data-nav-link={link.id} class={tw.navLink}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <button
        type="button"
        class={`inline-flex items-center justify-center rounded-full p-2 transition-colors duration-300 md:hidden ${tw.muted}`}
        aria-label="Toggle menu"
        aria-expanded="false"
        data-mobile-toggle
      >
        <svg class="h-6 w-6 transition-transform duration-300" data-icon-open fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="hidden h-6 w-6" data-icon-close fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div
    class={`grid overflow-hidden border-t transition-all duration-500 ease-out md:hidden grid-rows-[0fr] opacity-0 ${tw.navBg}`}
    data-mobile-menu
  >
    <div class="min-h-0">
      <div class="space-y-1 px-2 py-3">
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-mobile-link={link.id}
            class={`block rounded-xl px-3 py-2 text-base font-medium transition-all duration-300 ease-out hover:bg-purple-400/10 hover:text-purple-400 ${tw.muted}`}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  (function () {
    const nav = document.querySelector('[data-nav]') as HTMLElement | null;
    const toggle = document.querySelector('[data-mobile-toggle]') as HTMLButtonElement | null;
    const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
    const iconOpen = document.querySelector('[data-icon-open]') as HTMLElement | null;
    const iconClose = document.querySelector('[data-icon-close]') as HTMLElement | null;
    const indicator = document.querySelector('[data-nav-indicator]') as HTMLElement | null;
    const navLinks = Array.from(document.querySelectorAll('[data-nav-link]')) as HTMLAnchorElement[];
    const mobileLinks = Array.from(document.querySelectorAll('[data-mobile-link]')) as HTMLAnchorElement[];

    const sections = navLinks
      .map((l) => l.dataset.navLink)
      .filter(Boolean)
      .map((id) => document.getElementById(id!))
      .filter(Boolean) as HTMLElement[];

    const navHeight = () => nav?.offsetHeight ?? 64;

    function scrollToSection(id: string) {
      const target = document.getElementById(id);
      if (!target) return;
      const top = target.getBoundingClientRect().top + window.scrollY - navHeight() - 12;
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    }

    function handleNavClick(e: Event, id: string | undefined) {
      if (!id) return;
      e.preventDefault();
      scrollToSection(id);
      closeMobileMenu();
    }

    navLinks.forEach((link) => {
      link.addEventListener('click', (e) => handleNavClick(e, link.dataset.navLink));
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', (e) => handleNavClick(e, link.dataset.mobileLink));
    });

    document.querySelector('a[href="#home"]')?.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      closeMobileMenu();
    });

    function openMobileMenu() {
      menu?.classList.remove('grid-rows-[0fr]', 'opacity-0');
      menu?.classList.add('grid-rows-[1fr]', 'opacity-100');
      toggle?.setAttribute('aria-expanded', 'true');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }

    function closeMobileMenu() {
      menu?.classList.add('grid-rows-[0fr]', 'opacity-0');
      menu?.classList.remove('grid-rows-[1fr]', 'opacity-100');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }

    toggle?.addEventListener('click', () => {
      const isOpen = menu?.classList.contains('grid-rows-[1fr]');
      if (isOpen) closeMobileMenu();
      else openMobileMenu();
    });

    let current: string | null = null;

    function moveIndicator(activeLink: HTMLAnchorElement | undefined) {
      if (!indicator || !activeLink) return;
      const list = activeLink.closest('ul');
      if (!list) return;
      const linkRect = activeLink.getBoundingClientRect();
      const listRect = list.getBoundingClientRect();
      indicator.style.width = `${linkRect.width}px`;
      indicator.style.transform = `translateX(${linkRect.left - listRect.left}px)`;
      indicator.classList.remove('opacity-0');
    }

    function setActive(id: string) {
      if (id === current) return;
      current = id;

      navLinks.forEach((el) => {
        const isActive = el.dataset.navLink === id;
        if (isActive) {
          el.setAttribute('aria-current', 'true');
          moveIndicator(el);
        } else {
          el.removeAttribute('aria-current');
        }
      });

      mobileLinks.forEach((el) => {
        if (el.dataset.mobileLink === id) {
          el.classList.add('bg-purple-400/10', 'text-purple-400');
        } else {
          el.classList.remove('bg-purple-400/10', 'text-purple-400');
        }
      });
    }

    function updateActiveSection() {
      if (!sections.length) return;
      const scrollPos = window.scrollY + navHeight() + 80;
      let activeId = sections[0].id;

      for (const section of sections) {
        if (section.offsetTop <= scrollPos) activeId = section.id;
      }

      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        activeId = sections[sections.length - 1].id;
      }

      setActive(activeId);
    }

    let scrollTicking = false;
    window.addEventListener('scroll', () => {
      if (!scrollTicking) {
        requestAnimationFrame(() => {
          nav?.classList.toggle('shadow-lg', window.scrollY > 40);
          nav?.classList.toggle('shadow-purple-400/10', window.scrollY > 40);
          updateActiveSection();
          scrollTicking = false;
        });
        scrollTicking = true;
      }
    }, { passive: true });

    window.addEventListener('resize', () => {
      const active = navLinks.find((l) => l.dataset.navLink === current);
      if (active) moveIndicator(active);
    });

    updateActiveSection();
    if (sections[0]) setActive(sections[0].id);
  })();
</script>

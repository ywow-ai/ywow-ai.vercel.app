---
import { navLinks, siteConfig } from '../data/site';
import { tw } from '../lib/tw';

const year = new Date().getFullYear();
---

<footer class={`relative z-10 border-t py-10 backdrop-blur-sm ${tw.navBg}`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
      <div class="text-center md:text-left">
        <div class={`${tw.display} ${tw.gradientText} mb-2 text-2xl font-bold`}>{siteConfig.name}</div>
        <p class={`text-sm ${tw.muted}`}>Debugging reality, one line at a time.</p>
      </div>
      <div class="text-center">
        <p class={`text-sm ${tw.muted}`}>© {year} {siteConfig.name}. All rights reserved.</p>
        <p class={`mt-1 text-xs opacity-70 ${tw.muted}`}>Built with Astro & Tailwind CSS</p>
      </div>
      <div class="flex flex-wrap justify-center gap-5 text-sm">
        {navLinks.slice(0, 4).map((link) => (
          <a href={link.href} class={`transition-colors hover:text-purple-400 ${tw.muted}`}>{link.label}</a>
        ))}
      </div>
    </div>
    <div class={`${tw.divider} mt-8 max-w-xs opacity-50`}></div>
  </div>
</footer>
